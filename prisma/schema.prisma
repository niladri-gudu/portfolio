generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model VisitLog {
  id        String   @id @default(cuid())

  country   String   @default("UNKNOWN")
  region    String   @default("UNKNOWN")
  city      String   @default("UNKNOWN")

  referer   String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([country])
}

model GuestbookEntry {
  id        String   @id @default(cuid())
  name      String
  message   String
  reply     String?
  createdAt DateTime @default(now())
}