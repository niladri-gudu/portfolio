generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model VisitLog {
  id        String   @id @default(cuid())

  country   String   @default("UNKNOWN")
  region    String   @default("UNKNOWN")
  city      String   @default("UNKNOWN")

  referer   String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([country])
}

model GuestbookEntry {
  id        String   @id @default(cuid())
  name      String
  message   String
  reply     String?
  createdAt DateTime @default(now())
}

model SpotifyCache {
  id        String   @id @default("current")
  isPlaying Boolean  @default(false)
  title     String   @default("")
  artists   String   @default("")
  albumArt  String   @default("")
  url       String   @default("https://open.spotify.com/")
  progressMs Int?
  durationMs Int?
  playedAt  DateTime?
  stale     Boolean  @default(false)
  fetchedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}